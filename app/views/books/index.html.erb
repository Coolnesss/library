<%= stylesheet_link_tag "books" %>

<div class="page-heading">
  <h1><%= t('books.heading') %></h1>
</div>

<div class="container grid-lg">
  <%= render 'search', search: @search, count: @books.total_entries, stats: @stats %>

  <nav class="book-sort">
    <%= sort_link(@search, t('books.newest')) %>
    <%= sort_link(@search, t('books.search.title'), %w[title name]) %>
    <%= sort_link(@search, t('books.search.author'), %w[author author_sindhi]) %>
    <%= sort_link(@search, t('books.search.year'), %w[year]) %>
  </nav>

  <ol class="book-list">
    <% @books.each do |book| %>
      <li class="book-row">
        <%= link_to book, class: "book-thumb", tabindex: -1, 'aria-hidden': true do %>
          <img src="<%= cover_thumb_url(book) %>" alt="" loading="lazy">
        <% end %>

        <div class="book-text">
          <% titles = book_texts(book, :title) %>
          <% if titles.any? %>
            <h2 class="book-title"><%= link_to titles.first[0], book, **titles.first[1] %></h2>
          <% end %>
          <% titles.drop(1).each do |text, attributes| %>
            <div class="book-alt-title"><%= tag.span text, **attributes %></div>
          <% end %>

          <div class="book-meta">
            <% book_texts(book, :author).each do |text, attributes| %>
              <%= link_to text, books_search_path(author: text), **attributes %>
            <% end %>
            <span class="book-year"><%= book.year_str %></span>
          </div>

          <% if book.categories.any? %>
            <div class="book-tags">
              <% book.categories.each do |category| %>
                <%= link_to category.name, add_tag_path(@search, category.name), class: "chip", dir: "auto" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>

  <%= will_paginate @books, renderer: SpectrePaginationRenderer, class: "pagination book-pages", inner_window: 1, outer_window: 0 %>

  <p class="text-center">
    <%= link_to t("books.new_book"), new_book_path, class: "btn" %>
  </p>
</div>
