# Secrets for `kamal deploy -d staging`. Like .kamal/secrets, this holds only
# the names of environment variables from the deploy shell (deploy.env).
#
# Staging gets its own bucket and a key that can only reach that bucket, so it
# can never delete or replace a production book.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$STAGING_SECRET_KEY_BASE
S3_BUCKET_NAME=$STAGING_S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=$STAGING_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$STAGING_AWS_SECRET_ACCESS_KEY
AWS_REGION=$AWS_REGION

# Mail stays in the log on staging (MAIL_DELIVERY=log); these only satisfy
# production.rb's ENV.fetch.
GMAIL_APP_USER=staging-sends-no-mail
GMAIL_APP_PASS=staging-sends-no-mail
