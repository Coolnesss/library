# Kamal reads the deploy secrets from here. This file holds no values, only
# the names of environment variables it picks up from the shell you deploy in.
# Export them before running kamal deploy.
#
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
S3_BUCKET_NAME=$S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
AWS_REGION=$AWS_REGION
S3_ENDPOINT=$S3_ENDPOINT
GMAIL_APP_USER=$GMAIL_APP_USER
GMAIL_APP_PASS=$GMAIL_APP_PASS

# Umami. The container expects DATABASE_URL, so it is read from a differently
# named variable to keep DATABASE_URL out of the deploy shell, where it would
# otherwise override the library's own database config.
DATABASE_URL=$UMAMI_DATABASE_URL
POSTGRES_PASSWORD=$UMAMI_DB_PASSWORD
APP_SECRET=$UMAMI_APP_SECRET
