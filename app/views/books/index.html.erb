<%= stylesheet_link_tag "books" %>

<div style="padding: 2rem;">
  <h1>A river of read and unread books</h1>
  <h1 dir="rtl" class="sindhi">پڙهيل توڙي نہ پڙهيل ڪتابن جي ندي۔</h1>
</div>

<div class="container grid-xl">
  <%= render 'search', search: @search, count: @books.total_entries %>
</div>

<div class="container grid-xl hide-md">
  <div class="columns">
    <div class="column centered">
      <table class="table table-hover">
        <thead>
          <tr>
            <th><%= sort_header(@search, 'title', t('books.search.title')) %></th>
            <th><%= sort_header(@search, 'author', t('books.search.author')) %></th>
            <th class="hide-sm"><%= sort_header(@search, 'year', t('books.search.year')) %></th>
            <th dir="rtl" class="sindhi"><%= sort_header(@search, 'author_sindhi', "ليکڪ / مرتب") %></th>
            <th dir="rtl" class="sindhi"><%= sort_header(@search, 'name', "نالو") %></th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td><%= link_to book.name_eng, book %></td>
              <td><%= link_to book.author, books_search_path(author: book.author) %></td>
              <td class="hide-sm"><%= book.year_str or "Unknown" %></td>
              <td dir="rtl" class="<%= book.font_html_class %>"><%= link_to book.author_sindhi, books_search_path(author: book.author_sindhi) if book.author_sindhi.present? %></td>
              <td dir="rtl" class="<%= book.font_html_class %>"><%= link_to book.name, book %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <br>
      <%= will_paginate @books %>
      <br>
      <%= link_to 'New Book', new_book_path, class: "btn", style: "color: #5755d9" %>
    </div>
  </div>
</div>
<br />

<div class="container grid-sm show-md">
  <div class="columns">
    <div class="column centered">
    <% @books.each do |book| %>
      <div class="card">
          <a href=<%= book_path(book) %> class="card-image">
            <img src=<%= cover_url(book) %> class="img-responsive" height="30%">
          </a>

          <div class="card-header">
            <h4 class="card-title" style="text-align: center;">
              <%= book.name_eng %>
            </h4>

            <div class="card-body" style="display: flex; justify-content: center;">
              <% book.categories.each do |category| %>
              <div style="flex: 1; flex-grow:0;">
                <%= link_to category.name, add_tag_path(@search, category.name), class: "chip" %>
                </div>
              <% end %>
            </div>

            <div class="card-footer" style="justify-content: center; display: flex;">
              <% if book.attachment.attached? %>
                <%= link_to "<i class='icon icon-download centered'></i> Download".html_safe, book.attachment.url, class: "btn btn-link" %>
              <% end %>
            </div>
          </div>
      <br />
      
    </div>
    <% end %>
    <%= will_paginate @books, class: "pagination" %>
  </div>  
</div>
