
<div class="container grid-lg">
  <div class="columns">
    <div class="column centered">
      <%= stylesheet_link_tag "books" %>
      <%# The upload in the browser: app/javascript/book_form.js. %>
      <%= javascript_import_module_tag 'book_form' %>
      <%= form_for @book, html: { multipart: true, data: { pdf_worker: asset_path('pdfjs-worker.js') } } do |f| %>
        <div class="form-group">
            <div class="book-file">
              <%= tag.img class: "book-file-cover", alt: "", data: { cover_preview: true },
                          src: (url_for(@book.cover) if @book.cover.attached?), hidden: !@book.cover.attached? %>
              <div class="book-file-pick">
                <%= f.label :attachment, t('books.form.file'), class:"form-label" %>
                <%# Files from before a failed save are uploaded already: send them back, so they need not be chosen again. %>
                <% if @book.attachment.attached? && @book.attachment_changes['attachment'] %>
                  <%= f.hidden_field :attachment, value: @book.attachment.signed_id, data: { kept: true } %>
                  <p class="form-input-hint" data-kept><%= t('books.form.keeping', file: @book.attachment.filename) %></p>
                <% end %>
                <% if @book.cover.attached? && @book.attachment_changes['cover'] %>
                  <%= f.hidden_field :cover, value: @book.cover.signed_id, data: { kept: true } %>
                <% end %>
                <%# Our own button and file name: the browser's would be in its own
                    interface language, whatever the page's. %>
                <div class="file-picker">
                  <%= f.file_field :attachment, class: "file-picker-input", direct_upload: true, accept: ".pdf,application/pdf",
                                   data: { book_file: true, name: "book[attachment]" } %>
                  <label for="book_attachment" class="btn"><%= t('books.form.choose_file') %></label>
                  <span class="file-picker-name" data-file-name data-none="<%= t('books.form.no_file') %>" dir="auto">
                    <%= @book.attachment_changes['attachment'] && @book.attachment.attached? ? @book.attachment.filename : t('books.form.no_file') %>
                  </span>
                </div>
                <div class="book-upload" data-upload hidden
                     data-uploading="<%= t('books.form.uploading') %>" data-done="<%= t('books.form.uploaded') %>" data-failed="<%= t('books.form.upload_failed') %>">
                  <progress max="1" value="0"></progress>
                  <span data-upload-label></span>
                </div>
                <%= field_error f, :attachment %>
                <%= f.hidden_field :pages, data: { book_pages: true } %>
                <p class="form-input-hint book-autofill-note" data-autofill-note hidden><%= t('books.form.autofilled') %></p>
              </div>
            </div>

            <div class="divider"></div>

            <%= f.label :name, "نالو", class:"form-label sindhi bold" %>
            <%= f.text_field :name, class:"form-input sindhi", dir: "rtl", placeholder: "نالو" %>
            <%= field_error f, :name %>

            <%= f.label :name_eng, "Title", class:"form-label" %>
            <%= f.text_field :name_eng, class:"form-input", dir: "ltr", placeholder: "Title" %>
            <%= field_error f, :name_eng %>

            <%= f.label :isbn, t('books.form.isbn'), class:"form-label" %>
            <%= f.text_field :isbn, class:"form-input", dir: "ltr", placeholder: "ISBN" %>
            <%= field_error f, :isbn %>
            
            <%= f.label :author_sindhi, "ليکڪ / مرتب", class:"form-label sindhi" %>
            <%= f.text_field :author_sindhi, class:"form-input sindhi", dir: "rtl", placeholder: "ليکڪ / مرتب" %>

            <%= f.label :author, "Author / Editor", class:"form-label" %>
            <%= f.text_field :author, class:"form-input", dir: "ltr", placeholder: "Author / Editor" %>
            <%= field_error f, :author %>

            <%= f.label :translator, "Translator", class:"form-label" %>
            <%= f.text_field :translator, class:"form-input", dir: "ltr", placeholder: "Translator" %>

            <%= f.label :translator_sindhi, "مترجم", class:"form-label sindhi" %>
            <%= f.text_field :translator_sindhi, class:"form-input sindhi", dir: "rtl", placeholder: "مترجم" %>

            <%= f.label :language, t('books.form.language'), class:"form-label" %>
            <%= f.select :language, language_options, {include_blank: t('books.form.choose_language')}, class:"form-select" %>

            <%= f.label :publisher, t('books.form.publisher'), class:"form-label" %>
            <%= f.text_field :publisher, class:"form-input", dir: "auto" %>

            <%= f.label :description_sindhi, "تعارف", class:"form-label sindhi bold" %>
            <%= f.text_area :description_sindhi, class:"form-input sindhi", placeholder: "Sindhi description", dir: "rtl" %>

            <%= f.label :description_eng, "Intro", class:"form-label" %>
            <%= f.text_area :description_eng, class:"form-input", dir: "ltr", placeholder: "English description" %>

            <%= f.label :year, t('books.form.year'), class:"form-label" %>
            <%= f.number_field :year, class:"form-input", dir: "ltr" %>
            <%= field_error f, :year %>

            
            <br>

            
            <div data-tags>
              <%= t('books.form.tags') %>
              <div class="tags" data-tag-chips>
                <%# Keeps the list in the params when every chip is removed. %>
                <%= hidden_field_tag 'book[tag_names][]', '', id: nil %>
                <% @book.tag_names.each do |name| %>
                  <%= render 'tag_chip', name: name %>
                <% end %>
              </div>
              <template><%= render 'tag_chip', name: '' %></template>

              <br>
              <label class="form-label" for="new-tag"><%= t('books.form.add_tag') %></label>
              <input class="form-input" id="new-tag" list="tag-suggestions" autocomplete="off" data-tag-input>
              <datalist id="tag-suggestions">
                <% Category.order(:name).pluck(:name).each do |name| %>
                  <option value="<%= name %>">
                <% end %>
              </datalist>
            </div>

            <div class="actions">
              <br>
              <%= f.submit t('books.form.submit'), class: "btn btn-primary" %>
            </div>
            <br>
        </div>
      <% end %>
    </div>
  </div>
</div>
