<div class="container grid-sm">
  <div class="columns">
    <div class="column centered">
      <h1><%= t('users.register.heading') %></h1>

      <p class="text-center"><%= t('users.register.intro') %></p>

      <%= form_for @user, html: { class: "form-group" } do |f| %>
        <%= f.label :name, t('users.register.name'), class: "form-label" %>
        <%= f.text_field :name, class: "form-input", dir: "auto", autocomplete: "name" %>
        <%= field_error f, :name %>
        <br>

        <%= f.label :email, t('users.register.email'), class: "form-label" %>
        <%= f.email_field :email, class: "form-input", dir: "ltr", autocomplete: "email" %>
        <%= field_error f, :email %>
        <br>

        <%= f.label :password, t('users.register.password'), class: "form-label" %>
        <%= f.password_field :password, class: "form-input", dir: "ltr", autocomplete: "new-password" %>
        <%= field_error f, :password %>
        <br>

        <%= f.label :password_confirmation, t('users.register.password_confirmation'), class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-input", dir: "ltr", autocomplete: "new-password" %>
        <%= field_error f, :password_confirmation %>
        <br>

        <p><%= t('users.register.approval') %></p>

        <%= f.submit t('users.register.submit'), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
